# Fullnode endpoints accept host:port or an explicit scheme.
# Bare loopback addresses use HTTP/WS; public hosts use HTTPS/WSS.
# For another plaintext node, specify http:// and ws:// explicitly.
FULLNODE_API_BASE=127.0.0.1:12973
# Set this to your node's configured WebSocket port.
FULLNODE_WS_BASE=ws://127.0.0.1:11973

# Shared Telegram group ID for private features (e.g. -1001234567890).
# Add the existing Telegram bot to this group and allow it to send messages.
PRIVATE_CHAT_ID=

# Separate activity alert: more than this many transactions in the rolling window.
# 0 (or unset) disables it. For example, 100 alerts on the 101st transaction.
TX_COUNT_THRESHOLD=0
# Rolling timeframe, using a positive duration (e.g. 30s, 10m, 1h, 1h30m).
# Defaults to 5m when empty or unset. Invalid or nonpositive disables these alerts.
TX_COUNT_WINDOW=5m
# Requires PRIVATE_CHAT_ID. Empty, zero or invalid disables these alerts;
# there is no fallback to CHAT_ID.
# Counts unique, confirmed, non-coinbase transactions across all chain groups,
# regardless of transfer amounts. The window uses when confirmed blocks are
# processed, so notifications include the existing confirmation delay.
# Sends only to PRIVATE_CHAT_ID, using the existing TELEGRAM_TOKEN, once per crossing;
# rearms after the rolling count falls back to or below the threshold.
# These alerts are not posted to Twitter. Transfer and CEX trade alerts continue
# to use CHAT_ID and their existing Twitter settings.
# Includes the number of contributing blocks and links to the latest 3,
# using https://explorer.alephium.org/blocks/.
# Telegram links only the block number and omits whole block entries if the
# message would exceed 4096 bytes (a conservative character limit).
# State is in memory and starts empty on restart. Restart after changing settings;
# Docker Compose needs container recreation.

# Add these settings to your existing .env. Empty addresses disable Powfi.
# Set false to disable DEX swap polling and alerts. Defaults to true when unset.
# Lowercase dex_enabled is also accepted; false in either spelling disables tracking.
# Restart after changing this; Docker Compose needs container recreation.
DEX_ENABLED=true
# DEX swap alerts go only to PRIVATE_CHAT_ID with the existing TELEGRAM_TOKEN;
# they are not posted to Twitter. Missing or invalid PRIVATE_CHAT_ID disables DEX
# swap tracking, with no fallback to CHAT_ID.
# Comma-separated Powfi CLMM ALPH/token pool contracts; each is watched separately.
POWFI_POOL_ADDRESSES=xRF7AKLwpGjWzDpFFnUkdXBALKtotFcnD5XFf2EAyioZ
POWFI_POLL_INTERVAL_SEC=15
# Powfi uses FULLNODE_API_BASE from your existing configuration.
# Your node must index events for these contracts.
# Minimum Powfi swap value in USD (independent of CEX alerts).
MIN_AMOUNT_TRIGGER_DEX_USD=5000

# Additional private DEX signals, evaluated separately for each monitored pool.
# Both are disabled by default. They require DEX_ENABLED and PRIVATE_CHAT_ID.
# Rolling observation window for both signals; defaults to 5m.
DEX_SIGNAL_WINDOW=5m
# Alert at this many large ALPH buys OR large ALPH sells within the window.
# 0 disables; use at least 2 (e.g. 3). Each qualifying swap must meet the USD minimum.
DEX_REPEATED_SWAP_COUNT=0
DEX_REPEATED_SWAP_MIN_USD=5000
# Alert when either ALPH buys or sells reach this share of total estimated USD volume.
# 0 disables; otherwise use a percentage above 50 and at most 100 (e.g. 80).
DEX_IMBALANCE_PERCENT=0
# Minimum total volume and number of swaps before evaluating an imbalance.
DEX_IMBALANCE_MIN_VOLUME_USD=25000
DEX_IMBALANCE_MIN_SWAPS=5
# Imbalance includes ALL decoded swaps, even below MIN_AMOUNT_TRIGGER_DEX_USD.
# A transaction is counted once per pool within the window; repeated-swap counts
# are per direction, not per wallet. Only new events after startup are observed.
# Each condition alerts once until it clears; a switch in dominant side can alert.
# No new signal is sent solely because old swaps expire. All state resets on restart.
# Invalid settings disable the affected signal; an invalid window disables both.

# Only new events are tracked after startup. Cursors are kept in memory.
# Non-USDT pairs use the ALPH/USD price from PRICE_URL for valuation.
# Quote-token symbols and decimals must be available in TOKEN_LIST_URL.
# Pools without ALPH and CPMM contracts are not supported by this decoder.
